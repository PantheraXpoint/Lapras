MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=lapras_event_db
MONGO_USER=lapras
MONGO_PASSWORD=pwd
TTL_SECONDS=86400

# Hosted vLLM chat model used by smart_home_gs caption scripts.
# Start the server with e.g.:
#   vllm serve Qwen/Qwen3-8B --port 8000
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen3-8B
# OPENAI_API_KEY only needed if you started vllm with --api-key; otherwise leave as a dummy.
OPENAI_API_KEY=dummy
